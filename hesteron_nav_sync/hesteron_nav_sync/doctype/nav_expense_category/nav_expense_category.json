{
 "doctype": "DocType",
 "name": "NAV Expense Category",
 "module": "Hesteron Nav Sync",
 "autoname": "field:category_name",
 "engine": "InnoDB",
 "naming_rule": "By fieldname",
 "title_field": "category_name",
 "sort_field": "category_name",
 "sort_order": "ASC",
 "field_order": [
  "category_name",
  "target",
  "column_break_1",
  "expense_account",
  "negative_account",
  "section_detect",
  "keywords",
  "column_break_2",
  "group_by_carrier",
  "description"
 ],
 "fields": [
